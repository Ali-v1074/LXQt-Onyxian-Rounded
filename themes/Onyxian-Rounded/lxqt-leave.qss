/* ---------- Main Dialog Window ---------- */
QDialog {
    background: #202020;
    border: 1px solid #393939;
}

/* ---------- Caption Colors ---------- */
QLabel {
    color: #dedede;
    margin: 17px 0 3px;
}

/* ---------- Session Action Buttons ---------- */
QAbstractItemView {
    color: #dedede;
    background: #2a2a2a;
    /* note: must use solid color 1px .png image for bg color */
    background-image: url(/assets/lxqt-leave/background.png);
    border: 1px solid #393939;
    border-radius: 17px;
    margin: 0 10px;
}

/* ---------- Confirmation Dialog Buttons ---------- */
QToolButton {
    color: #dedede;
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 10px;
    margin: 0 8px;
    padding: 3px 0 3px 6px;
    qproperty-icon: url(/assets/navigation/window-close.svg);
}

/* RTL-specific styles */
QToolButton[layoutDirection="1"] {
    padding: 3px 6px 3px 0;
}

QToolButton:hover {
    color: #ffffff;
    background: #3d3d3d;
    border: 1px solid #7c7c7c;
}

QToolButton:pressed {
    color: #dedede;
    background: #303030;
    border: 1px solid #4a4a4a;
}
