/* ---------- Panel ---------- */
#panel {
    background: #202020;
    border: 1px solid #393939;
    border-radius: 20px;
    margin: 8px 0;
    padding: 5px;
}

/* ---------- Buttons ---------- */
QToolButton::menu-indicator {
    image: none;
}

#closeButton {
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 17px;
    margin: 4px 6px;
    padding: 7px 8px;
    qproperty-iconSize: 16px;
    qproperty-icon: url(/assets/navigation/window-close.svg);
}

#actionButton {
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 17px;
    margin: 4px 6px;
    padding: 7px 9px;
    qproperty-iconSize: 16px;
    qproperty-icon: url(/assets/navigation/go-down.svg);
}

#closeButton:hover,
#actionButton:hover {
    color: #ffffff;
    background: #3d3d3d;
    border: 1px solid #7c7c7c;
}

#closeButton:pressed,
#actionButton:pressed {
    background: #303030;
    border: 1px solid #4a4a4a;
}

/* ---------- Search Line-Edit ---------- */
#commandEd {
    color: #dedede;
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 17px;
    margin: 2px;
    padding: 6px 8px;
    selection-color: #ffffff;
    selection-background-color: #5a5a5a;
}

/* ---------- Search Results List ---------- */
#commandList {
    color: #dedede;
    background: #202020;
    border: 1px solid #393939;
    border-radius: 20px;
    padding: 20px;
    selection-color: #ffffff;
    alternate-background-color: transparent;
}

#commandList::item {
    color: #dedede;
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 17px;
    margin: 5px 0;
}

#commandList::item:hover {
    background: #3d3d3d;
    border: 1px solid #7c7c7c;
}

#commandList::item:selected {
    background: #555555;
    border: 1px solid #838383;
}

#commandList::item:hover:selected {
    background: #656565;
    border: 1px solid #a2a2a2;
}

/* ---------- Menu ---------- */
QMenu {
    color: #dedede;
    background: #202020;
    border: 1px solid #393939;
    border-radius: 20px;
    margin: 0;
    padding: 12px;
}

QMenu::icon {
    background: transparent;
    padding-left: 12px;
}

QMenu::separator {
    background: #4c4c4c;
    margin: 5px;
    height: 1px;
}

QMenu::item {
    color: #dedede;
    background: #2a2a2a;
    border: 1px solid #393939;
    border-radius: 16px;
    margin: 5px;
    padding: 5px;
    font-size: 13px;
}

QMenu::item:selected {
    color: #ffffff;
    background: #3d3d3d;
    border: 1px solid #7c7c7c;
}

QMenu::item:pressed {
    color: #dedede;
    background: #303030;
    border: 1px solid #4a4a4a;
}
